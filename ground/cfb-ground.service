[Unit]
Description=CFB ground service (receive, ack, store)
After=wg-quick@wg0.service
Requires=wg-quick@wg0.service

[Service]
ExecStart=/usr/local/bin/cfb-ground --listen 10.66.0.1:7400 --log /var/lib/cfb-ground/rx.log
DynamicUser=yes
StateDirectory=cfb-ground
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
