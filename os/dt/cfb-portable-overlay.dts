//
// Portable CFB on a Raspberry Pi 5: sensors on the header I2C bus.
//   ISM330DHCX accelerometer/gyro at 0x6a (SA0 low; 0x6b if SA0 high)
//   BMP390 barometer at 0x77 (SDO high; 0x76 if SDO low)
// Build:   dtc -@ -I dts -O dtb -o cfb-portable.dtbo os/dt/cfb-portable-overlay.dts
// Install: cp cfb-portable.dtbo /boot/firmware/overlays/
// config.txt (see os/dt/config.txt.snippet):  dtparam=i2c_arm=on  +  dtoverlay=cfb-portable
// Check:   ls /sys/bus/iio/devices/*/name ; cat /sys/bus/iio/devices/*/name
/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2712";

	fragment@0 {
		target = <&i2c_arm>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			ism330dhcx@6a {
				compatible = "st,ism330dhcx";
				reg = <0x6a>;
			};

			bmp390@77 {
				compatible = "bosch,bmp390";
				reg = <0x77>;
			};
		};
	};
};
