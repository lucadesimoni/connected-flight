[Unit]
Description=Connected Flight Box (cfb-io | cfbd)
After=network.target NetworkManager.service ModemManager.service
Wants=wg-quick@wg-wifi.service wg-quick@wg-cell.service

[Service]
Type=notify
# cfbd sends the sd_notify messages from inside the pipeline.
NotifyAccess=all
EnvironmentFile=/etc/cfb/io.env
# UART receivers need the baud rate set; harmless for USB (ttyACM) devices.
ExecStartPre=-/bin/stty -F ${CFB_GNSS} ${CFB_GNSS_BAUD} raw -echo
ExecStart=/bin/sh -c '/usr/local/bin/cfb-io --gnss "$CFB_GNSS" --discretes /run/cfb/discretes --hw "$CFB_HW" | exec /usr/local/bin/cfbd --config /etc/cfb/cfb.toml'
WatchdogSec=10
Restart=always
RestartSec=2
# Hardening: unprivileged; radio switching, rauc install and reboot are
# granted to user cfb by os/polkit/50-cfb.rules and nothing else.
User=cfb
Group=cfb
SupplementaryGroups=dialout gpio
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# /data/cfb: queue; /data/updates: OTA downloads; /run/cfb: discretes, OTA confirm
ReadWritePaths=/data/cfb /data/updates /run/cfb
MemoryMax=64M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
