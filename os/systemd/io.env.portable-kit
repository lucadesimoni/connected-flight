# /etc/cfb/io.env for the portable kit (docs/14). Pin plan: os/dt/config.txt.snippet.
CFB_GNSS=/dev/ttyAMA0
CFB_GNSS_BAUD=38400
CFB_HW=base,gnss,imu,baro,wifi,cellular_4g,iridium
CFB_IMU_IIO=ism330dhcx
CFB_BARO_IIO=bmp
# libgpiod 2.x (Raspberry Pi OS Trixie): lines by name, bias set per read.
#  rfsw: switch ON pulls GPIO23 to GND -> reads 0 -> inverted to 1 (radios may run).
#        A broken or missing switch wire reads 1 -> inverted to 0 = OFF (fail-safe).
#  pfail: X1200 PLD low = supply lost -> reads 0 -> inverted to 1 (power fail).
CFB_GPIO="rfsw=gpioget --bias=pull-up GPIO23;pfail=gpioget GPIO6"
CFB_INVERT="rfsw pfail"
