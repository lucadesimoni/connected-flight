# Runs once after boot. If the new slot is healthy, mark it good; if this
# never runs (crash, hang -> hardware watchdog reset), the boot counter runs
# out and the bootloader falls back to the previous slot.
[Unit]
Description=Mark booted RAUC slot good after health check
After=cfbd.service
Requires=cfbd.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 60
ExecStartPre=/usr/bin/systemctl is-active --quiet cfbd.service
ExecStart=/usr/bin/rauc status mark-good

[Install]
WantedBy=multi-user.target
