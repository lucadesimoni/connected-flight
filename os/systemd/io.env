# /etc/cfb/io.env - inputs of this unit
CFB_GNSS=/dev/ttyAMA0
# u-blox M9/M10 receivers default to 38400 baud (no inline comments in this file).
CFB_GNSS_BAUD=38400
CFB_HW=base,gnss,wifi,cellular_4g
# IIO sensor name patterns (empty = not fitted); add imu,baro to CFB_HW too.
CFB_IMU_IIO=
CFB_BARO_IIO=
# Optional GPIO discretes (override /run/cfb/discretes). libgpiod 2.x syntax
# (Raspberry Pi OS Trixie); values with spaces in double quotes; no inline comments.
#CFB_GPIO="wow=gpioget --bias=pull-up GPIO24;eng=gpioget --bias=pull-up GPIO25"
# Portable kit: radio switch (active low) and UPS power-fail signal:
#CFB_GPIO="rfsw=gpioget --bias=pull-up GPIO23;pfail=gpioget GPIO6"
#CFB_INVERT="rfsw pfail"
