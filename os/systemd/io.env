# /etc/cfb/io.env - inputs of this unit
CFB_GNSS=/dev/ttyACM0
CFB_GNSS_BAUD=9600
CFB_HW=base,gnss,wifi,cellular_4g
# IIO sensor name patterns (empty = not fitted); add imu,baro to CFB_HW too.
CFB_IMU_IIO=
CFB_BARO_IIO=
# Optional GPIO discretes (override /run/cfb/discretes). libgpiod v2 syntax:
#CFB_GPIO=wow=gpioget -c gpiochip0 17;eng=gpioget -c gpiochip0 27
# Portable kit: radio switch (active low) and UPS power-fail signal:
#CFB_GPIO=rfsw=gpioget -c gpiochip0 22;pfail=gpioget -c gpiochip0 27
#CFB_INVERT=rfsw
